script "Comet Speed Density Ribbon"

input (
  baselineSeconds = input.int(180, title: "Baseline active seconds", min: 30, max: 900)
  warmupSeconds = input.int(45, title: "Minimum warmup seconds", min: 10, max: 180)
  speedGatePct = input.float(90.0, title: "Speed percentile gate", min: 60.0, max: 99.9)
  activityGatePct = input.float(90.0, title: "Activity percentile gate", min: 60.0, max: 99.9)
  activityReleasePct = input.float(65.0, title: "Drive release percentile", min: 20.0, max: 90.0)
  denseGatePct = input.float(70.0, title: "Dense move percentile", min: 50.0, max: 99.0)
  thinGatePct = input.float(30.0, title: "Thin move percentile", min: 1.0, max: 50.0)
  speedDecayRatio = input.float(0.60, title: "Response-fade speed ratio", min: 0.10, max: 0.95)
  densityFloorTicks = input.float(0.25, title: "Density move floor (ticks)", min: 0.05, max: 10.0)

  palette = input.select("Ice & Ember", title: "Palette", options: ["Ice & Ember", "Aurora", "Muted Pro", "Custom"])
  weakOpacity = input.int(72, title: "Weak ribbon opacity", min: 20, max: 160)
  peakOpacity = input.int(255, title: "Peak ribbon opacity", min: 160, max: 255, sameLine: true)
  intensityGamma = input.float(0.72, title: "Intensity grading", min: 0.25, max: 2.0)
  customBearishPeak = input.color(color.rgb(255, 48, 67), title: "Custom bearish peak", when: palette == "Custom")
  customBearishMid = input.color(color.rgb(102, 20, 31), title: "Custom bearish mid", sameLine: true, when: palette == "Custom")
  customNeutral = input.color(color.rgb(112, 118, 128), title: "Custom neutral", when: palette == "Custom")
  customBullishMid = input.color(color.rgb(17, 55, 94), title: "Custom bullish mid", sameLine: true, when: palette == "Custom")
  customBullishPeak = input.color(color.rgb(73, 158, 255), title: "Custom bullish peak", sameLine: true, when: palette == "Custom")
)

setup (
  bearishPeak = palette == "Ice & Ember" ? color.rgb(255, 48, 67) : (palette == "Aurora" ? color.rgb(255, 54, 132) : (palette == "Muted Pro" ? color.rgb(222, 92, 101) : customBearishPeak))
  bearishMid = palette == "Ice & Ember" ? color.rgb(102, 20, 31) : (palette == "Aurora" ? color.rgb(100, 24, 68) : (palette == "Muted Pro" ? color.rgb(91, 47, 52) : customBearishMid))
  neutral = palette == "Ice & Ember" ? color.rgb(112, 118, 128) : (palette == "Aurora" ? color.rgb(108, 108, 128) : (palette == "Muted Pro" ? color.rgb(122, 126, 134) : customNeutral))
  bullishMid = palette == "Ice & Ember" ? color.rgb(17, 55, 94) : (palette == "Aurora" ? color.rgb(16, 75, 105) : (palette == "Muted Pro" ? color.rgb(42, 68, 99) : customBullishMid))
  bullishPeak = palette == "Ice & Ember" ? color.rgb(73, 158, 255) : (palette == "Aurora" ? color.rgb(40, 208, 255) : (palette == "Muted Pro" ? color.rgb(101, 151, 211) : customBullishPeak))
  ribbonScale = color.scale(
    at: [-100.0, -50.0, 0.0, 50.0, 100.0],
    colors: [bearishPeak, bearishMid, neutral, bullishMid, bullishPeak],
    space: colorspace.rgb,
    easing: easing.smootherstep,
  )
)

data (
  chart = subscribe(data.ohlcv)
  tape = subscribe(data.trades, history: 30m)
)

pane ribbonPane = pane(title: "Comet Speed + Density Ribbon", height: 0.16)

plot (
  driveGlow = plot.line(title: "Comet drive glow", width: 5.0, showLabel: false, showValue: false, on: ribbonPane)
  densityGlow = plot.line(title: "Density glow", width: 3.5, showLabel: false, showValue: false, on: ribbonPane)
  driveRibbon = plot.line(title: "Directional drive", width: 1.7, showLabel: true, showValue: true, on: ribbonPane)
  densityRibbon = plot.line(title: "Directional density", width: 1.1, showLabel: true, showValue: true, on: ribbonPane)
  zeroPlot = plot.line(title: "Zero", color: color.withAlpha(color.silver, 28), width: 0.7, showLabel: false, showValue: false, on: ribbonPane)
)

state (
  speedHistory = rolling<float>(baselineSeconds)
  countHistory = rolling<float>(baselineSeconds)
  sizeHistory = rolling<float>(baselineSeconds)
  densityHistory = rolling<float>(baselineSeconds)

  currentSecond: int = -1
  tradeCount = 0.0
  grossSize = 0.0
  firstPrice = 0.0
  lastPrice = 0.0

  hasPreviousBucket = false
  previousMoveTicks = 0.0
  previousCount = 0.0
  previousSize = 0.0

  driveActive = false
  driveDirection: int = 0
  drivePeakSpeed = 0.0

  latestReady = false
  latestState: int = 0
  latestDirection: int = 0
  latestImpulseDirection: int = 0
  latestSpeedPct = 0.0
  latestActivityPct = 0.0
  latestDensityPct = 0.0
)

on tape.trade(tr) {
  let tradeSecond = time.unixSeconds(tr.time) ?? 0

  if currentSecond != tradeSecond {
    if currentSecond >= 0 && tradeCount > 0.0 {
      let rawMoveTicks = (lastPrice - firstPrice) / context.tickSize
      let smoothMoveTicks = hasPreviousBucket ? (rawMoveTicks + previousMoveTicks) / 2.0 : rawMoveTicks
      let smoothSpeed = hasPreviousBucket ? (math.abs(rawMoveTicks) + math.abs(previousMoveTicks)) / 2.0 : math.abs(rawMoveTicks)
      let smoothCount = hasPreviousBucket ? (tradeCount + previousCount) / 2.0 : tradeCount
      let smoothSize = hasPreviousBucket ? (grossSize + previousSize) / 2.0 : grossSize
      let density = smoothSize / math.max(densityFloorTicks, smoothSpeed)

      let effectiveWarmup = math.min(warmupSeconds, baselineSeconds)
      let ready = speedHistory.len >= effectiveWarmup && countHistory.len >= effectiveWarmup && sizeHistory.len >= effectiveWarmup && densityHistory.len >= effectiveWarmup
      let speedPct = speedHistory.len > 0 ? speedHistory.countLte(smoothSpeed) * 1.0 / (speedHistory.len * 1.0) : 0.0
      let countPct = countHistory.len > 0 ? countHistory.countLte(smoothCount) * 1.0 / (countHistory.len * 1.0) : 0.0
      let sizePct = sizeHistory.len > 0 ? sizeHistory.countLte(smoothSize) * 1.0 / (sizeHistory.len * 1.0) : 0.0
      let densityPct = densityHistory.len > 0 ? densityHistory.countLte(density) * 1.0 / (densityHistory.len * 1.0) : 0.0
      let activityPct = 0.6 * math.max(countPct, sizePct) + 0.4 * math.min(countPct, sizePct)
      let direction = smoothMoveTicks > 0.0 ? 1 : (smoothMoveTicks < 0.0 ? -1 : 0)

      let speedHigh = speedPct >= speedGatePct / 100.0
      let activityHigh = activityPct >= activityGatePct / 100.0
      let activityReleased = activityPct < activityReleasePct / 100.0
      let denseMove = densityPct >= denseGatePct / 100.0
      let thinMove = densityPct <= thinGatePct / 100.0
      let drive = ready && direction != 0 && speedHigh && activityHigh
      let responseFade = ready && driveActive && activityHigh && denseMove && smoothSpeed <= drivePeakSpeed * speedDecayRatio

      latestReady = ready
      latestDirection = direction
      latestSpeedPct = speedPct
      latestActivityPct = activityPct
      latestDensityPct = densityPct

      if responseFade {
        latestState = 3
        latestImpulseDirection = driveDirection
        driveActive = false
        driveDirection = 0
        drivePeakSpeed = 0.0
      } else if drive {
        let continuingDrive = driveActive && driveDirection == direction
        latestState = thinMove ? 1 : (denseMove ? 2 : 4)
        driveDirection = direction
        latestImpulseDirection = direction
        drivePeakSpeed = continuingDrive ? math.max(drivePeakSpeed, smoothSpeed) : smoothSpeed
        driveActive = true
      } else {
        latestState = ready && activityHigh && denseMove ? 2 : 0
        if activityReleased || !ready {
          driveActive = false
          driveDirection = 0
          drivePeakSpeed = 0.0
        } else if driveActive {
          drivePeakSpeed = math.max(drivePeakSpeed, smoothSpeed)
        }
      }

      // Score first, then append: the current sample never enters its own baseline.
      speedHistory.push(smoothSpeed)
      countHistory.push(smoothCount)
      sizeHistory.push(smoothSize)
      densityHistory.push(density)

      previousMoveTicks = rawMoveTicks
      previousCount = tradeCount
      previousSize = grossSize
      hasPreviousBucket = true
    }

    currentSecond = tradeSecond
    tradeCount = 0.0
    grossSize = 0.0
    firstPrice = tr.price
    lastPrice = tr.price
  }

  tradeCount += 1.0
  grossSize += tr.size
  lastPrice = tr.price
}

on chart.update {
  // Height compares joint speed/activity with density; sign remains actual price direction.
  // These are display coordinates only. The research-state thresholds above are unchanged.
  let drivePct = 0.6 * math.max(latestSpeedPct, latestActivityPct) + 0.4 * math.min(latestSpeedPct, latestActivityPct)
  let signedDrive = latestDirection * drivePct * 100.0
  let signedDensity = latestDirection * latestDensityPct * 100.0
  let driveMagnitude = math.clamp(math.abs(signedDrive) / 100.0, 0.0, 1.0)
  let densityMagnitude = math.clamp(math.abs(signedDensity) / 100.0, 0.0, 1.0)
  let driveCurve = math.pow(driveMagnitude, intensityGamma) ?? 0.0
  let densityCurve = math.pow(densityMagnitude, intensityGamma) ?? 0.0
  let driveAlpha = int(math.round(weakOpacity + (peakOpacity - weakOpacity) * driveCurve, 0)) ?? peakOpacity
  let densityAlpha = int(math.round(weakOpacity + (peakOpacity - weakOpacity) * densityCurve, 0)) ?? peakOpacity
  let driveBase = ribbonScale.sample(signedDrive)
  let densityBase = ribbonScale.sample(signedDensity)
  let driveGlowAlpha = int(math.round(10.0 + 34.0 * driveCurve, 0)) ?? 24
  let densityGlowAlpha = int(math.round(8.0 + 26.0 * densityCurve, 0)) ?? 18
  let driveValue: float? = latestReady && latestDirection != 0 ? signedDrive : null
  let densityValue: float? = latestReady && latestDirection != 0 ? signedDensity : null

  driveGlow.plot(driveValue, color: color.withAlpha(driveBase, driveGlowAlpha))
  densityGlow.plot(densityValue, color: color.withAlpha(densityBase, densityGlowAlpha))
  driveRibbon.plot(driveValue, color: color.withAlpha(driveBase, driveAlpha))
  densityRibbon.plot(densityValue, color: color.withAlpha(densityBase, densityAlpha))
  zeroPlot.plot(0.0)
}
