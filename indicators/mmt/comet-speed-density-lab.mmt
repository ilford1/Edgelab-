script "Comet Speed Density Lab"

input (
  baselineSeconds = input.int(180, title: "Baseline active seconds", min: 30, max: 900)
  warmupSeconds = input.int(45, title: "Minimum warmup seconds", min: 10, max: 180)
  speedGatePct = input.float(90.0, title: "Speed percentile gate", min: 60.0, max: 99.9)
  activityGatePct = input.float(90.0, title: "Activity percentile gate", min: 60.0, max: 99.9)
  activityReleasePct = input.float(65.0, title: "Drive release percentile", min: 20.0, max: 90.0)
  denseGatePct = input.float(70.0, title: "Dense move percentile", min: 50.0, max: 99.0)
  thinGatePct = input.float(30.0, title: "Thin move percentile", min: 1.0, max: 50.0)
  speedDecayRatio = input.float(0.60, title: "Response-fade speed ratio", min: 0.10, max: 0.95)
  densityFloorTicks = input.float(0.25, title: "Density move floor (ticks)", min: 0.05, max: 10.0)
  showMarkers = input.bool(true, title: "Show research-state markers")
  upColor = input.color(color.rgb(49, 221, 187), title: "Up impulse")
  downColor = input.color(color.rgb(255, 92, 112), title: "Down impulse", sameLine: true)
)

data (
  chart = subscribe(data.ohlcv)
  tape = subscribe(data.trades, history: 30m)
)

pane cometPanel = pane(title: "Comet Speed + Density", height: 0.28)

plot (
  speedPlot = plot.histogram(title: "Signed speed percentile", color: color.withAlpha(color.cyan, 120), showLabel: true, showValue: true, on: cometPanel)
  activityPlot = plot.line(title: "Trade activity percentile", color: color.amber, width: 1.5, showLabel: true, showValue: true, on: cometPanel)
  densityPlot = plot.line(title: "Volume-per-move percentile", color: color.magenta, width: 1.5, showLabel: true, showValue: true, on: cometPanel)
  speedGatePlot = plot.line(title: "Speed gate +", color: color.withAlpha(color.gray, 150), width: 1.0, style: linestyle.dotted, showLabel: false, showValue: true, on: cometPanel)
  negativeSpeedGatePlot = plot.line(title: "Speed gate -", color: color.withAlpha(color.gray, 150), width: 1.0, style: linestyle.dotted, showLabel: false, showValue: true, on: cometPanel)
  statePlot = plot.line(title: "Research state", color: color.white, width: 2.0, style: linestyle.step, showLabel: true, showValue: true, on: cometPanel)
)

state (
  speedHistory = rolling<float>(baselineSeconds)
  countHistory = rolling<float>(baselineSeconds)
  sizeHistory = rolling<float>(baselineSeconds)
  densityHistory = rolling<float>(baselineSeconds)

  currentSecond: int = -1
  tradeCount = 0.0
  grossSize = 0.0
  firstPrice = 0.0
  lastPrice = 0.0

  hasPreviousBucket = false
  previousMoveTicks = 0.0
  previousCount = 0.0
  previousSize = 0.0

  driveActive = false
  driveDirection: int = 0
  drivePeakSpeed = 0.0

  latestReady = false
  latestState: int = 0
  latestDirection: int = 0
  latestImpulseDirection: int = 0
  latestSpeedPct = 0.0
  latestActivityPct = 0.0
  latestDensityPct = 0.0
  latestMoveTicks = 0.0
  latestTradeRate = 0.0
  latestSizeRate = 0.0
  latestDensity = 0.0

  eventSequence = 0
  stateMarkers = entities.markerPool(max: 360)
  stateLabels = entities.labelPool(max: 120)
  hudBoxes = entities.boxPool(max: 12, anchor: anchor.topLeft)
  hudLabels = entities.labelPool(max: 16, anchor: anchor.topLeft)
)

on tape.trade(tr) {
  let tradeSecond = time.unixSeconds(tr.time) ?? 0

  if currentSecond != tradeSecond {
    if currentSecond >= 0 && tradeCount > 0.0 {
      let rawMoveTicks = (lastPrice - firstPrice) / context.tickSize
      let smoothMoveTicks = hasPreviousBucket ? (rawMoveTicks + previousMoveTicks) / 2.0 : rawMoveTicks
      let smoothSpeed = hasPreviousBucket ? (math.abs(rawMoveTicks) + math.abs(previousMoveTicks)) / 2.0 : math.abs(rawMoveTicks)
      let smoothCount = hasPreviousBucket ? (tradeCount + previousCount) / 2.0 : tradeCount
      let smoothSize = hasPreviousBucket ? (grossSize + previousSize) / 2.0 : grossSize
      let density = smoothSize / math.max(densityFloorTicks, smoothSpeed)

      let effectiveWarmup = math.min(warmupSeconds, baselineSeconds)
      let ready = speedHistory.len >= effectiveWarmup && countHistory.len >= effectiveWarmup && sizeHistory.len >= effectiveWarmup && densityHistory.len >= effectiveWarmup
      let speedPct = speedHistory.len > 0 ? speedHistory.countLte(smoothSpeed) * 1.0 / (speedHistory.len * 1.0) : 0.0
      let countPct = countHistory.len > 0 ? countHistory.countLte(smoothCount) * 1.0 / (countHistory.len * 1.0) : 0.0
      let sizePct = sizeHistory.len > 0 ? sizeHistory.countLte(smoothSize) * 1.0 / (sizeHistory.len * 1.0) : 0.0
      let densityPct = densityHistory.len > 0 ? densityHistory.countLte(density) * 1.0 / (densityHistory.len * 1.0) : 0.0
      let activityPct = 0.6 * math.max(countPct, sizePct) + 0.4 * math.min(countPct, sizePct)
      let direction = smoothMoveTicks > 0.0 ? 1 : (smoothMoveTicks < 0.0 ? -1 : 0)

      let speedHigh = speedPct >= speedGatePct / 100.0
      let activityHigh = activityPct >= activityGatePct / 100.0
      let activityReleased = activityPct < activityReleasePct / 100.0
      let denseMove = densityPct >= denseGatePct / 100.0
      let thinMove = densityPct <= thinGatePct / 100.0
      let drive = ready && direction != 0 && speedHigh && activityHigh
      let responseFade = ready && driveActive && activityHigh && denseMove && smoothSpeed <= drivePeakSpeed * speedDecayRatio

      latestReady = ready
      latestDirection = direction
      latestSpeedPct = speedPct
      latestActivityPct = activityPct
      latestDensityPct = densityPct
      latestMoveTicks = smoothMoveTicks
      latestTradeRate = smoothCount
      latestSizeRate = smoothSize
      latestDensity = density

      if responseFade {
        latestState = 3
        latestImpulseDirection = driveDirection
        eventSequence += 1
        let fadeColor = driveDirection > 0 ? downColor : upColor
        if showMarkers {
          stateMarkers.get(eventSequence, "fade-outer").set(
            x: tr.time, y: tr.price, shape: shape.circle,
            color: color.withAlpha(fadeColor, 45), size: 34.0, zIndex: 5,
          )
          stateMarkers.get(eventSequence, "fade-core").set(
            x: tr.time, y: tr.price, shape: shape.diamond,
            color: fadeColor, size: 8.0, zIndex: 6,
          )
          stateLabels.get(eventSequence).set(
            x: tr.time,
            y: driveDirection > 0 ? tr.price + context.tickSize * 7.0 : tr.price - context.tickSize * 7.0,
            text: "RESPONSE FADE",
            color: fadeColor, size: 8.0, font: font.mono, textAlign: "center", zIndex: 7,
          )
        }
        driveActive = false
        driveDirection = 0
        drivePeakSpeed = 0.0
      } else if drive {
        let continuingDrive = driveActive && driveDirection == direction
        latestState = thinMove ? 1 : (denseMove ? 2 : 4)
        driveDirection = direction
        latestImpulseDirection = direction
        drivePeakSpeed = continuingDrive ? math.max(drivePeakSpeed, smoothSpeed) : smoothSpeed
        driveActive = true

        if showMarkers && !continuingDrive {
          eventSequence += 1
          let driveColor = direction > 0 ? upColor : downColor
          stateMarkers.get(eventSequence, "drive-outer").set(
            x: tr.time, y: tr.price, shape: shape.circle,
            color: color.withAlpha(driveColor, 35), size: 24.0, zIndex: 5,
          )
          stateMarkers.get(eventSequence, "drive-core").set(
            x: tr.time, y: tr.price, shape: shape.circle,
            color: driveColor, size: 7.0, zIndex: 6,
          )
        }
      } else {
        latestState = ready && activityHigh && denseMove ? 2 : 0
        if activityReleased || !ready {
          driveActive = false
          driveDirection = 0
          drivePeakSpeed = 0.0
        } else if driveActive {
          drivePeakSpeed = math.max(drivePeakSpeed, smoothSpeed)
        }
      }

      // Score the completed two-active-second sample against prior samples,
      // then append it. This prevents the current observation entering its own baseline.
      speedHistory.push(smoothSpeed)
      countHistory.push(smoothCount)
      sizeHistory.push(smoothSize)
      densityHistory.push(density)

      previousMoveTicks = rawMoveTicks
      previousCount = tradeCount
      previousSize = grossSize
      hasPreviousBucket = true
    }

    currentSecond = tradeSecond
    tradeCount = 0.0
    grossSize = 0.0
    firstPrice = tr.price
    lastPrice = tr.price
  }

  tradeCount += 1.0
  grossSize += tr.size
  lastPrice = tr.price
}

on chart.update {
  let directionColor = latestDirection > 0 ? upColor : (latestDirection < 0 ? downColor : color.gray)
  let stateColor = latestState == 3 ? (latestImpulseDirection > 0 ? downColor : upColor) : (latestState == 2 ? color.magenta : directionColor)
  let status = !latestReady ? "WARMING" : (latestState == 1 ? "THIN DRIVE" : (latestState == 2 ? "DENSE ACTIVITY" : (latestState == 3 ? "RESPONSE FADE" : (latestState == 4 ? "ACTIVE DRIVE" : "NORMAL"))))
  let direction = latestDirection > 0 ? "UP" : (latestDirection < 0 ? "DOWN" : "FLAT")
  let signedSpeedPct = latestDirection * latestSpeedPct * 100.0
  let stateValue = latestState == 1 ? 25.0 : (latestState == 4 ? 50.0 : (latestState == 2 ? 75.0 : (latestState == 3 ? 100.0 : 0.0)))

  speedPlot.plot(signedSpeedPct, color: color.withAlpha(directionColor, 135))
  activityPlot.plot(latestActivityPct * 100.0)
  densityPlot.plot(latestDensityPct * 100.0)
  speedGatePlot.plot(speedGatePct)
  negativeSpeedGatePlot.plot(-speedGatePct)
  statePlot.plot(stateValue, color: stateColor)

  hudBoxes.get("glow").set(
    x1: 12.0, y1: 12.0, x2: 346.0, y2: 282.0,
    rounding: 16.0,
    color: color.withAlpha(stateColor, latestState > 0 ? 22 : 9),
    borderColor: color.withAlpha(stateColor, latestState > 0 ? 70 : 35),
    borderWidth: 1.0, zIndex: 20,
  )
  hudBoxes.get("card").set(
    x1: 18.0, y1: 18.0, x2: 340.0, y2: 276.0,
    rounding: 13.0,
    color: color.rgb(8, 12, 18, 238),
    borderColor: color.withAlpha(stateColor, latestState == 3 ? 230 : 110),
    borderWidth: latestState == 3 ? 2.0 : 1.0, zIndex: 21,
  )
  hudBoxes.get("header").set(
    x1: 28.0, y1: 28.0, x2: 330.0, y2: 76.0,
    rounding: 9.0, color: color.withAlpha(stateColor, latestState > 0 ? 40 : 18), zIndex: 22,
  )

  hudLabels.get("title").set(x: 40.0, y: 42.0, text: "COMET SPEED / DENSITY", color: color.white, size: 12.0, font: font.mono, textAlign: "left", zIndex: 24)
  hudLabels.get("status").set(x: 40.0, y: 63.0, text: status, color: stateColor, size: 11.0, font: font.mono, textAlign: "left", zIndex: 24)
  hudLabels.get("direction").set(x: 286.0, y: 52.0, text: direction, color: directionColor, size: 15.0, font: font.mono, textAlign: "left", zIndex: 24)

  hudLabels.get("speed-key").set(x: 40.0, y: 102.0, text: "PRICE SPEED", color: color.gray, size: 10.0, font: font.mono, textAlign: "left", zIndex: 24)
  hudLabels.get("speed-value").set(x: 210.0, y: 102.0, text: str.format("{0:.1}t/s  ·  p{1:.0}", latestMoveTicks, latestSpeedPct * 100.0), color: color.white, size: 10.0, font: font.mono, textAlign: "left", zIndex: 24)

  hudLabels.get("trade-key").set(x: 40.0, y: 136.0, text: "TRADE RATE", color: color.gray, size: 10.0, font: font.mono, textAlign: "left", zIndex: 24)
  hudLabels.get("trade-value").set(x: 210.0, y: 136.0, text: str.format("{0:.1}/s  ·  p{1:.0}", latestTradeRate, latestActivityPct * 100.0), color: color.white, size: 10.0, font: font.mono, textAlign: "left", zIndex: 24)

  hudLabels.get("volume-key").set(x: 40.0, y: 170.0, text: "VOLUME RATE", color: color.gray, size: 10.0, font: font.mono, textAlign: "left", zIndex: 24)
  hudLabels.get("volume-value").set(x: 210.0, y: 170.0, text: str.format("{0:.2}/s", latestSizeRate), color: color.white, size: 10.0, font: font.mono, textAlign: "left", zIndex: 24)

  hudLabels.get("density-key").set(x: 40.0, y: 204.0, text: "VOLUME / MOVE", color: color.gray, size: 10.0, font: font.mono, textAlign: "left", zIndex: 24)
  hudLabels.get("density-value").set(x: 210.0, y: 204.0, text: str.format("{0:.2} q/t  ·  p{1:.0}", latestDensity, latestDensityPct * 100.0), color: color.white, size: 10.0, font: font.mono, textAlign: "left", zIndex: 24)

  hudLabels.get("clock").set(x: 40.0, y: 238.0, text: "2 ACTIVE-SECOND SMA · PRIOR BASELINE", color: color.rgb(112, 123, 139), size: 9.0, font: font.mono, textAlign: "left", zIndex: 24)
  hudLabels.get("note").set(x: 40.0, y: 258.0, text: "RESEARCH STATE · NOT AN ENTRY", color: color.rgb(112, 123, 139), size: 9.0, font: font.mono, textAlign: "left", zIndex: 24)
}
